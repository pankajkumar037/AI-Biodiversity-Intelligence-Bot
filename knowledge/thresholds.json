      {"min": 6.5, "max": 7.5, "label": "neutral"},
      {"min": 7.5, "max": 8.5, "label": "alkaline", "flag": "alkaline_soil"},
      {"min": 8.5, "label": "strongly_alkaline", "flag": "sodic_risk"}
    ],
    "source": "Standard agronomic soil reaction classes (USDA / ICAR soil testing)",
    "verify": true
  },
  {
    "rule_id": "T-AI-01",
    "metric": "aridity_index",
    "bands": [
      {"max": 0.05, "label": "hyper_arid", "flag": "water_limited"},
      {"min": 0.05, "max": 0.2, "label": "arid", "flag": "water_limited"},
      {"min": 0.2, "max": 0.5, "label": "semi_arid", "flag": "water_limited"},
      {"min": 0.5, "max": 0.65, "label": "dry_sub_humid", "flag": "dry_subhumid"},
      {"min": 0.65, "label": "humid"}
    ],
    "source": "UNEP/UNCCD aridity index (P/PET) classes as used in the Global Aridity Index database",
    "verify": false
  },
  {
    "rule_id": "T-RAIN-01",
    "metric": "rainfall_mm",
    "bands": [
      {"max": 300, "label": "very_low", "flag": "water_limited"},
      {"min": 300, "max": 600, "label": "low", "flag": "water_limited"},
      {"min": 600, "max": 1000, "label": "moderate"},
      {"min": 1000, "label": "high"}
    ],
    "source": "Arid <300 mm and semi-arid 300-600 mm rainfall bands used for Indian dryland agro-ecological zoning",
    "verify": true
  },
  {
    "rule_id": "T-COVER-01",
    "metric": "natural_cover_percent",
    "bands": [
      {"max": 10, "label": "very_low", "flag": "low_natural_cover"},
      {"min": 10, "max": 30, "label": "low", "flag": "low_natural_cover"},
      {"min": 30, "label": "adequate"}
    ],
    "source": "Landscape ecology guidance that habitat below roughly 30% of the landscape sharply reduces connectivity; band edges are a starting estimate",
    "verify": true
  },
  {
    "rule_id": "T-HAB-01",
    "metric": "habitat_diversity_index",
    "bands": [
      {"max": 0.8, "label": "very_low", "flag": "low_habitat_diversity"},
      {"min": 0.8, "max": 1.3, "label": "low", "flag": "low_habitat_diversity"},
      {"min": 1.3, "label": "adequate"}
    ],
    "source": "Shannon H' over land cover class proportions in a 1 km buffer; band edges are a starting estimate and need a landscape-ecology source",
    "verify": true
  },
  {
    "rule_id": "T-SYS-01",
    "metric": "cropping_system",
    "match": [
      {"equals": "monoculture", "label": "monoculture", "flag": "monoculture"},
      {"equals": "fallow", "label": "fallow", "flag": "bare_fallow"}
    ],
    "source": "Categorical rule: a single-species system carries the diversity penalties described in FAO SOWBFA (2019)",
    "verify": false
  },
  {
    "rule_id": "T-BIO-01",
    "metric": "biodiversity_trend",
    "match": [
      {"equals": "declining", "label": "declining", "flag": "biodiversity_decline"}
    ],
    "source": "Categorical rule: user-reported trend, treated as an observation not a measurement",
    "verify": false
  }
